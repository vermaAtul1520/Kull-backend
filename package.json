{
  "name": "kull-backend",
  "version": "1.0.0",
  "description": "KULL - Multi-Community Platform Backend",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "dev:dynamodb": "DB_TYPE=dynamodb nodemon index.js",
    "test": "jest --testPathIgnorePatterns=integration",
    "test:watch": "jest --watch --testPathIgnorePatterns=integration",
    "test:coverage": "jest --coverage --testPathIgnorePatterns=integration",
    "test:integration": "jest --testPathPattern=integration",
    "test:all": "jest",
    "db:create-tables": "node scripts/create-dynamodb-tables.js",
    "db:local": "docker run -d -p 8000:8000 amazon/dynamodb-local",
    "db:migrate": "node scripts/migrate-to-dynamodb.js",
    "db:migrate:dry-run": "node scripts/migrate-to-dynamodb.js --dry-run",
    "sam:build": "sam build",
    "sam:local": "sam local start-api",
    "sam:deploy": "sam deploy",
    "sam:deploy:dev": "sam deploy --config-env dev",
    "sam:deploy:staging": "sam deploy --config-env staging",
    "sam:deploy:prod": "sam deploy --config-env prod",
    "sam:logs": "sam logs -n KullFunction --stack-name kull-backend-prod --tail"
  },
  "keywords": [
    "kull",
    "community",
    "platform",
    "node",
    "express",
    "mongodb"
  ],
  "author": "Innovgeist - Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/client-ses": "^3.987.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@codegenie/serverless-express": "^4.17.1",
    "@sendgrid/mail": "^8.1.5",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "mongodb": "^6.17.0",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "nodemailer": "^6.9.4",
    "sharp": "^0.32.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.6.4",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
